# Variables del listener. En el servidor va en /etc/buscatools/listener.env
# con permisos 600 y dueño root.
#
#   sudo install -m 600 -o root -g root listener.env /etc/buscatools/listener.env
#
# NINGUNA de estas variables va al navegador. El service role key da acceso
# total a la base saltando RLS: vive en este archivo y en ningún otro lado.

SUPABASE_URL=https://uaxcfufvapzulqvynanp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# La empresa y la cuenta NO vienen del evento de WhatsApp: se fijan acá. Si
# vinieran adentro del mensaje, cualquiera que pudiera inyectar un evento
# escribiría en la empresa que quisiera.
INTERNAL_WHATSAPP_COMPANY_ID=
INTERNAL_WHATSAPP_ACCOUNT_ID=

# La base es la fuente de verdad, no la memoria del proceso.
WHATSAPP_REPOSITORIO=supabase

# El kill switch. En `false` el proceso sigue conectado y NO ingiere nada.
# Apagarlo no desvincula la sesión: volver a encenderlo no pide QR.
LISTENER_ENABLED=true

# El puerto del healthcheck. No se expone a internet.
HEALTH_PORT=8081

# La allowlist NO se configura acá: sale de `whatsapp_group_allowlist` y se
# refresca sola cada minuto. Habilitar un grupo no requiere reiniciar.
